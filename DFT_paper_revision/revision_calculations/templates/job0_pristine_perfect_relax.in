&CONTROL
    ! Revision job 0: relaxation of the PRISTINE PERFECT cell. The production
    ! value (-4275.01530 Ry) is a single point on the positions of the bulk
    ! variable-cell relaxation, with a residual force of 0.0225 Ry/Bohr in the
    ! 2x2x1 cell at Gamma (run log; main text Section 2.6). Relaxing it lowers
    ! E(Pristine_perfect) and raises the pristine E_f(V_O) and the two reductions
    ! measured from it; the doped-cell results do not depend on this cell.
    ! Same thresholds and settings as the production relaxations.
    calculation     = 'relax'
    prefix          = '__PREFIX__'
    outdir          = '__OUTDIR__'
    pseudo_dir      = '__PSEUDO_DIR__'
    verbosity       = 'high'
    restart_mode    = 'from_scratch'
    tprnfor         = .true.
    tstress         = .false.
    disk_io         = 'low'
    nstep           = 300
    forc_conv_thr   = 5.0d-3
/
&SYSTEM
    ibrav           = 0
    nat             = 48
    ntyp            = 2
    ecutwfc         = 40.0
    ecutrho         = 320.0
    occupations     = 'smearing'
    smearing        = 'gaussian'
    degauss         = __DEGAUSS__
    nspin           = 2
    starting_magnetization(1) = __MAG_TI__
    starting_magnetization(2) = __MAG_O__
/
&ELECTRONS
    conv_thr        = 1.0d-8
    mixing_mode     = 'plain'
    mixing_beta     = 0.1
    diagonalization = 'david'
    electron_maxstep = 300
    startingwfc     = 'atomic+random'
/
&IONS
    ion_dynamics    = 'bfgs'
    bfgs_ndim       = 3
/
ATOMIC_SPECIES
  Ti  47.867   Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
  O   15.999   O.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
   7.63632000   0.00000000   0.00000000
   0.00000000   7.63632000   0.00000000
   0.00000000   0.00000000   9.77900000
ATOMIC_POSITIONS angstrom
__ATOMIC_POSITIONS__
K_POINTS automatic
1 1 1 0 0 0
HUBBARD (ortho-atomic)
U Ti-3d 3.5
