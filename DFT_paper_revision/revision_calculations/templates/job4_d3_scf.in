&CONTROL
    ! Revision job 4 (dispersion, audit R13): D3(BJ) single point on a
    ! perfect doped cell. Together with the existing D3 single points of
    ! Pr_VO and Rb_VO and the D3 O2 box this closes the D3 formation-energy
    ! cycle. D3 is added to the energy only, so E(D3) - E(PBE+U) is the D3 term.
    calculation     = 'scf'
    prefix          = '__PREFIX__'
    outdir          = '__OUTDIR__'
    pseudo_dir      = '__PSEUDO_DIR__'
    verbosity       = 'high'
    restart_mode    = 'from_scratch'
    tprnfor         = .true.
    tstress         = .false.
    disk_io         = 'low'
/
&SYSTEM
    ibrav           = 0
    nat             = __NAT__
    ntyp            = 3
    ecutwfc         = 40.0
    ecutrho         = 320.0
    occupations     = 'smearing'
    smearing        = 'gaussian'
    degauss         = __DEGAUSS__
    nspin           = 2
    starting_magnetization(1) = __MAG_TI__
    starting_magnetization(2) = __MAG_O__
    starting_magnetization(3) = __MAG_DOP__
    vdw_corr        = 'dft-d3'
    dftd3_version   = 4
    dftd3_threebody = .false.
/
&ELECTRONS
    conv_thr        = 1.0d-8
    mixing_mode     = 'plain'
    mixing_beta     = 0.1
    diagonalization = 'david'
    electron_maxstep = 250
    startingwfc     = 'atomic+random'
/
ATOMIC_SPECIES
  Ti  47.867   Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
  O   15.999   O.pbe-n-kjpaw_psl.1.0.0.UPF
__DOPANT_SPECIES__
CELL_PARAMETERS angstrom
   7.63632000   0.00000000   0.00000000
   0.00000000   7.63632000   0.00000000
   0.00000000   0.00000000   9.77900000
ATOMIC_POSITIONS angstrom
__ATOMIC_POSITIONS__
K_POINTS automatic
1 1 1 0 0 0
HUBBARD (ortho-atomic)
U Ti-3d 3.5
