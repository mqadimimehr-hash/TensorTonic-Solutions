&CONTROL
    ! Revision job 4, O2 part: triplet O2 with D3(BJ), 12 A cubic box,
    ! 40 and 320 Ry, plain PBE (no Hubbard U). Short relaxation from
    ! d(O-O) = 1.23 A; the D3 term of a single O2 molecule is small.
    calculation     = 'relax'
    prefix          = '__PREFIX__'
    outdir          = '__OUTDIR__'
    pseudo_dir      = '__PSEUDO_DIR__'
    verbosity       = 'high'
    restart_mode    = 'from_scratch'
    tprnfor         = .true.
    tstress         = .false.
    disk_io         = 'low'
    nstep           = 50
    forc_conv_thr   = 1.0d-4
    etot_conv_thr   = 1.0d-6
/
&SYSTEM
    ibrav           = 0
    nat             = 2
    ntyp            = 1
    ecutwfc         = 40.0
    ecutrho         = 320.0
    occupations     = 'smearing'
    smearing        = 'gaussian'
    degauss         = __DEGAUSS__
    nspin           = 2
    tot_magnetization = 2
    starting_magnetization(1) = 0.5
    vdw_corr        = 'dft-d3'
    dftd3_version   = 4
    dftd3_threebody = .false.
/
&ELECTRONS
    conv_thr        = 1.0d-8
    mixing_mode     = 'plain'
    mixing_beta     = 0.1
    diagonalization = 'david'
    electron_maxstep = 250
    startingwfc     = 'atomic+random'
/
&IONS
    ion_dynamics    = 'bfgs'
/
ATOMIC_SPECIES
  O   15.999   O.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  12.00000000   0.00000000   0.00000000
   0.00000000  12.00000000   0.00000000
   0.00000000   0.00000000  12.00000000
ATOMIC_POSITIONS angstrom
O     6.00000000   6.00000000   5.38500000
O     6.00000000   6.00000000   6.61500000
K_POINTS automatic
1 1 1 0 0 0
